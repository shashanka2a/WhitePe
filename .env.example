# Public origin of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Whitechain Sepolia deployed contract addresses (populated after deployment)
# NEXT_PUBLIC_SETTLEMENT_CONTRACT=0x...
# NEXT_PUBLIC_INVOICE_REGISTRY_CONTRACT=0x...

# Arkiv Network (Web3 Database) Configuration (Rabdi Testnet - Chain ID 7794095)
# Obtain an access key at https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
# Funded private key for writing on-chain entities with tGLM from https://hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=
# Client-side access key for public verification queries
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
